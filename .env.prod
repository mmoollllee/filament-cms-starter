APP_NAME="Projektname"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Image driver for the media library's conversions. GD decodes an image
# UNCOMPRESSED into PHP's memory — a 4000x3000 camera photo is roughly 48 MB per
# copy, and a conversion holds source and target at once, so a regenerate over
# real uploads dies part-way through on the usual 128M limit. Imagick manages
# its own buffers outside that limit. Leave it on `gd` only where the imagick
# extension is genuinely unavailable, and raise memory_limit if you do.
IMAGE_DRIVER=imagick

CACHE_STORE=file

# Port 587 → Symfony negotiates STARTTLS on its own, MAIL_SCHEME/MAIL_ENCRYPTION
# are not needed. Enter MAIL_PASSWORD on the server only — this file is tracked
# in git as a template! Diagnose the transport with:
# `php artisan app:send-test-mail [empfaenger]`.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Alternative: the hoster's sendmail.
#MAIL_MAILER=sendmail
#MAIL_SENDMAIL_PATH='/usr/sbin/sendmail -t -i'

VITE_APP_NAME="${APP_NAME}"

SPAMPROTECT_KEY=

# Umami analytics (mmoollllee/filami). The credentials are a dedicated Umami
# user and gate auto-provisioning + the panel widgets; UMAMI_PASSWORD belongs on
# the server only. Tracking itself needs only the per-tenant website id.
UMAMI_URL=
UMAMI_USERNAME=
UMAMI_PASSWORD=

# Consent category gating the session-replay recorder — declared in
# config/consent-control.php. The plain pageview tracker is never gated.
UMAMI_RECORDER_CONSENT_CATEGORY=analytics

# Own hosts that should not count as "outbound" when a visitor moves between
# them (exact hostnames, comma separated). Leaving it unset is equally valid.
#UMAMI_INTERNAL_DOMAINS=example.com,shop.example.com
